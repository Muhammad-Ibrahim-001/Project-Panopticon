        ],
        "partitions": [
          {
            "name": "agg_daily_censorship_severity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\\\Semester Projects\\\\Panopticon\\\\data\\\\powerbi_export\\\\agg_daily_censorship_severity.csv\"), [Delimiter=\",\", Columns=26, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"date_key\", Int64.Type}, {\"calendar_date\", type date}, {\"country_code\", type text}, {\"asn_id\", type text}, {\"category_code\", type text}, {\"test_family\", type text}, {\"total_measurements\", Int64.Type}, {\"ooni_attested_tampered\", Int64.Type}, {\"confirmed_blocked_count\", Int64.Type}, {\"interference_signal_count\", Int64.Type}, {\"heuristic_only_count\", Int64.Type}, {\"dns_tampering_count\", Int64.Type}, {\"tcp_reset_count\", Int64.Type}, {\"tls_drop_count\", Int64.Type}, {\"http_block_count\", Int64.Type}, {\"anomaly_unclassified_count\", Int64.Type}, {\"dns_flag_count\", Int64.Type}, {\"tcp_flag_count\", Int64.Type}, {\"tls_flag_count\", Int64.Type}, {\"http_flag_count\", Int64.Type}, {\"avg_test_runtime_seconds\", type number}, {\"cai_pct\", type number}, {\"confirmed_rate_pct\", type number}, {\"interference_rate_pct\", type number}, {\"load_timestamp\", type datetime}, {\"_batch_id\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Measurements",
            "expression": "SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[total_measurements]))",
            "formatString": "#,0"
          },
          {
            "name": "Tampered Probes",
            "expression": "SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[ooni_attested_tampered]))",
            "formatString": "#,0"
          },
          {
            "name": "Censorship Aggression Index %",
            "expression": "DIVIDE([Tampered Probes], [Total Measurements], 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Confirmed Blocked Count",
            "expression": "SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[confirmed_blocked_count]))",
            "formatString": "#,0"
          },
          {
            "name": "DNS Tampering %",
            "expression": "DIVIDE(SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[dns_tampering_count])), [Total Measurements], 0) * 100",
            "formatString": "0.00%"
          },
          {
            "name": "TCP Reset DPI %",
            "expression": "DIVIDE(SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[tcp_reset_count])), [Total Measurements], 0) * 100",
            "formatString": "0.00%"
          },
          {
            "name": "TLS Drop %",
            "expression": "DIVIDE(SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[tls_drop_count])), [Total Measurements], 0) * 100",
            "formatString": "0.00%"
          },
          {
            "name": "Targeted Censorship Count",
            "expression": "SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[ooni_attested_tampered]))",
            "formatString": "#,0"
          },
          {
            "name": "Collateral Disruption Count",
            "expression": "SUMX(agg_daily_censorship_severity, VALUE(agg_daily_censorship_severity[interference_signal_count]))",
            "formatString": "#,0"
          },
          {
            "name": "Surgical Precision Index",
            "expression": "DIVIDE([Targeted Censorship Count], [Collateral Disruption Count], 0) * 100",
            "formatString": "0.00"
          }
        ]
      },
