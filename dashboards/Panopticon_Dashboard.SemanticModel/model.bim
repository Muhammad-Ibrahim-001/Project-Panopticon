                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\\\Semester Projects\\\\Panopticon\\\\data\\\\powerbi_export\\\\fact_network_measurement.csv\"), [Delimiter=\",\", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
