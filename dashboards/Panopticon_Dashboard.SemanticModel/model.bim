                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"measurement_id\", type text}, {\"date_time_key\", Int64.Type}, {\"date_key\", Int64.Type}, {\"calendar_date\", type date}, {\"country_code\", type text}, {\"asn_id\", type text}, {\"category_code\", type text}, {\"test_name\", type text}, {\"test_family\", type text}, {\"target_domain\", type text}, {\"tampering_vector\", type text}, {\"classification_status\", type text}, {\"is_anomaly_flag\", Int64.Type}, {\"dns_anomaly_flag\", Int64.Type}, {\"tcp_anomaly_flag\", Int64.Type}, {\"tls_anomaly_flag\", Int64.Type}, {\"http_anomaly_flag\", Int64.Type}, {\"ooni_anomaly_flag\", Int64.Type}, {\"ooni_confirmed_flag\", Int64.Type}, {\"test_runtime_seconds\", type number}, {\"taxonomy_version\", type text}, {\"event_timestamp\", type datetime}, {\"load_timestamp\", type datetime}, {\"_batch_id\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Measurement Probes",
            "expression": "COUNTROWS(fact_network_measurement)",
            "formatString": "#,0"
          },
          {
            "name": "Anomalous Probes",
            "expression": "CALCULATE(COUNTROWS(fact_network_measurement), fact_network_measurement[is_anomaly_flag] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "TCP RST Count",
            "expression": "CALCULATE(COUNTROWS(fact_network_measurement), fact_network_measurement[tcp_anomaly_flag] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "DNS Tamper Count",
            "expression": "CALCULATE(COUNTROWS(fact_network_measurement), fact_network_measurement[dns_anomaly_flag] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "HTTP Block Count",
            "expression": "CALCULATE(COUNTROWS(fact_network_measurement), fact_network_measurement[http_anomaly_flag] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "TLS Drop Count",
            "expression": "CALCULATE(COUNTROWS(fact_network_measurement), fact_network_measurement[tls_anomaly_flag] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "CAI %",
            "expression": "DIVIDE([Anomalous Probes], [Measurement Probes], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Confirmed Probes",
            "expression": "CALCULATE(COUNTROWS(fact_network_measurement), fact_network_measurement[ooni_confirmed_flag] = 1)",
            "formatString": "#,0"
          }
        ]
