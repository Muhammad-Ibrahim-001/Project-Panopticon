            "sourceColumn": "error_message"
          }
        ],
        "partitions": [
          {
            "name": "pipeline_execution_logs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\\\Semester Projects\\\\Panopticon\\\\data\\\\powerbi_export\\\\pipeline_execution_logs.csv\"), [Delimiter=\",\", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"log_id\", type text}, {\"pipeline_layer\", type text}, {\"batch_parameter\", type text}, {\"load_type\", type text}, {\"start_time\", type datetime}, {\"end_time\", type datetime}, {\"duration_seconds\", type number}, {\"status\", type text}, {\"rows_read\", Int64.Type}, {\"rows_inserted\", Int64.Type}, {\"rows_updated\", Int64.Type}, {\"rows_quarantined\", Int64.Type}, {\"error_message\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Audit Logs",
            "expression": "COUNTROWS(pipeline_execution_logs)",
            "formatString": "#,0"
          },
          {
            "name": "ACID Success Rate %",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(pipeline_execution_logs), pipeline_execution_logs[status] = \"Success\"), COUNTROWS(pipeline_execution_logs), 1)",
            "formatString": "0.0%"
          },
          {
            "name": "Mean Batch Duration Sec",
            "expression": "AVERAGEX(pipeline_execution_logs, VALUE(pipeline_execution_logs[duration_seconds]))",
            "formatString": "0.0s"
          },
          {
            "name": "Total Rows Inserted",
            "expression": "SUMX(pipeline_execution_logs, VALUE(pipeline_execution_logs[rows_inserted]))",
            "formatString": "#,0"
          },
          {
            "name": "Total Rows Read",
            "expression": "SUMX(pipeline_execution_logs, VALUE(pipeline_execution_logs[rows_read]))",
            "formatString": "#,0"
          },
          {
            "name": "Total Quarantined",
            "expression": "SUMX(pipeline_execution_logs, VALUE(pipeline_execution_logs[rows_quarantined]))",
            "formatString": "#,0"
          },
          {
            "name": "Total Cloud Spend USD",
            "expression": "0.00",
            "formatString": "\"$\"#,##0.00"
          }
        ]
      }
