{
  "title": "Panopticon Silver DNS Experiments Child Table Schema",
  "description": "Normalized, exploded DNS query and answer-level telemetry contract for silver_dns_experiments",
  "type": "struct",
  "fields": [
    {
      "name": "query_id",
      "type": "string",
      "nullable": false,
      "metadata": {
        "comment": "PK: SHA-256(measurement_id || query_pos)"
      }
    },
    {
      "name": "measurement_id",
      "type": "string",
      "nullable": false,
      "metadata": {
        "comment": "FK to silver_network_measurements"
      }
    },
    {
      "name": "measurement_date",
      "type": "date",
      "nullable": false,
      "metadata": {
        "comment": "Partition column"
      }
    },
    {
      "name": "probe_cc",
      "type": "string",
      "nullable": false,
      "metadata": {
        "comment": "Probe country"
      }
    },
    {
      "name": "query_pos",
      "type": "integer",
      "nullable": false,
      "metadata": {
        "comment": "Zero-based position inside test_keys.queries"
      }
    },
    {
      "name": "query_type",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "A / AAAA / HTTPS ..."
      }
    },
    {
      "name": "query_hostname",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Hostname queried"
      }
    },
    {
      "name": "query_engine",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Resolver engine (system/udp/doh...)"
      }
    },
    {
      "name": "query_failure",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "OONI failure string, NULL on success"
      }
    },
    {
      "name": "is_dns_failure",
      "type": "boolean",
      "nullable": false,
      "metadata": {
        "comment": "True when query_failure is present"
      }
    },
    {
      "name": "total_answers_count",
      "type": "integer",
      "nullable": false,
      "metadata": {
        "comment": "Number of answers"
      }
    },
    {
      "name": "ipv4_answers_count",
      "type": "integer",
      "nullable": false,
      "metadata": {
        "comment": "Answers carrying an IPv4 address"
      }
    },
    {
      "name": "cname_answers_count",
      "type": "integer",
      "nullable": false,
      "metadata": {
        "comment": "CNAME answers (answer_type CNAME or hostname set)"
      }
    },
    {
      "name": "load_timestamp",
      "type": "timestamp",
      "nullable": false,
      "metadata": {
        "comment": "Audit load time"
      }
    }
  ]
}
