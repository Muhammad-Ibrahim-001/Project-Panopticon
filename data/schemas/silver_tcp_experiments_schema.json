{
  "title": "Panopticon Silver TCP Experiments Child Table Schema",
  "description": "Normalized, exploded TCP connection-level telemetry contract for silver_tcp_experiments",
  "type": "struct",
  "fields": [
    {
      "name": "tcp_connect_id",
      "type": "string",
      "nullable": false,
      "metadata": {
        "comment": "PK: SHA-256(measurement_id || tcp_pos)"
      }
    },
    {
      "name": "measurement_id",
      "type": "string",
      "nullable": false,
      "metadata": {
        "comment": "FK to silver_network_measurements"
      }
    },
    {
      "name": "measurement_date",
      "type": "date",
      "nullable": false,
      "metadata": {
        "comment": "Partition column"
      }
    },
    {
      "name": "probe_cc",
      "type": "string",
      "nullable": false,
      "metadata": {
        "comment": "Probe country"
      }
    },
    {
      "name": "tcp_pos",
      "type": "integer",
      "nullable": false,
      "metadata": {
        "comment": "Zero-based position inside test_keys.tcp_connect"
      }
    },
    {
      "name": "destination_ip",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Target server IP (not a probe/activist address)"
      }
    },
    {
      "name": "destination_port",
      "type": "integer",
      "nullable": true,
      "metadata": {
        "comment": "Target port"
      }
    },
    {
      "name": "is_blocked",
      "type": "boolean",
      "nullable": false,
      "metadata": {
        "comment": "OONI status.blocked"
      }
    },
    {
      "name": "failure_reason",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "OONI status.failure"
      }
    },
    {
      "name": "is_success",
      "type": "boolean",
      "nullable": false,
      "metadata": {
        "comment": "OONI status.success"
      }
    },
    {
      "name": "load_timestamp",
      "type": "timestamp",
      "nullable": false,
      "metadata": {
        "comment": "Audit load time"
      }
    }
  ]
}
