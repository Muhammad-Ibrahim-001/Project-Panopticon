    {
      "name": "pipeline_logs",
      "displayName": "Pipeline Execution Logs",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/logs/pipeline_execution_logs`"
      ],
      "columns": [
        {
          "displayName": "success_rate_pct",
          "description": "Percentage of pipeline runs with status 'Success'",
          "expression": "100.0 * SUM(CASE WHEN `status` = 'Success' THEN 1 ELSE 0 END) / NULLIF(COUNT(`log_id`), 0)"
        }
      ]
    },
    {
      "name": "dim_country",
      "displayName": "Country-Region Dimension",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/dim_country_region`"
      ]
    },
    {
      "name": "agg_hourly",
      "displayName": "Hourly Censorship Aggregation",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/agg_hourly_censorship_severity`"
      ]
    },
    {
      "name": "attack_vectors",
      "displayName": "Attack Vector Breakdown",
      "queryLines": [
        "SELECT\n",
        "  test_family,\n",
        "  'DNS_TAMPERING' AS vector_type,\n",
        "  SUM(dns_tampering_count) AS count\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/agg_daily_censorship_severity`\n",
        "GROUP BY\n",
        "  test_family\n",
        "UNION ALL\n",
        "SELECT\n",
        "  test_family,\n",
        "  'TCP_RESET' AS vector_type,\n",
        "  SUM(tcp_reset_count) AS count\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/agg_daily_censorship_severity`\n",
        "GROUP BY\n",
        "  test_family\n",
        "UNION ALL\n",
        "SELECT\n",
        "  test_family,\n",
        "  'TLS_DROP' AS vector_type,\n",
        "  SUM(tls_drop_count) AS count\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/agg_daily_censorship_severity`\n",
        "GROUP BY\n",
        "  test_family\n",
        "UNION ALL\n",
        "SELECT\n",
        "  test_family,\n",
        "  'HTTP_BLOCK' AS vector_type,\n",
        "  SUM(http_block_count) AS count\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/agg_daily_censorship_severity`\n",
        "GROUP BY\n",
        "  test_family\n",
        "UNION ALL\n",
        "SELECT\n",
        "  test_family,\n",
        "  'ANOMALY_UNCLASSIFIED' AS vector_type,\n",
        "  SUM(anomaly_unclassified_count) AS count\n",
        "FROM\n",
        "  delta.`/Volumes/workspace/default/panopticon/gold/agg_daily_censorship_severity`\n",
        "GROUP BY\n",
        "  test_family"
      ]
    }
  ],
